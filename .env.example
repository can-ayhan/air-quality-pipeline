# PostgreSQL warehouse. These are the defaults, also used by docker-compose.yml;
# copy to .env only to change them.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5435
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=airquality
WAREHOUSE_PASSWORD=airquality

# Where failed tasks post their alert: a chat webhook that takes {"text": "..."}.
# Empty: the alert only goes to the task log.
ALERT_WEBHOOK_URL=
